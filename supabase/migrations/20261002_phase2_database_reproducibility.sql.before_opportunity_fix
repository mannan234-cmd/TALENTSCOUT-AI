-- ============================================================
-- 6. MIGRATE LEGACY OPPORTUNITY DATA
-- ============================================================

UPDATE public.opportunities
SET organization = organization_name
WHERE organization IS NULL
  AND organization_name IS NOT NULL;


UPDATE public.opportunities
SET remote =
    CASE
        WHEN lower(trim(work_mode)) IN (
            'remote',
            'fully remote',
            'work from home',
            'wfh'
        )
        THEN TRUE

        WHEN work_mode IS NOT NULL
             AND trim(work_mode) <> ''
        THEN FALSE

        ELSE NULL
    END
WHERE remote IS NULL;


UPDATE public.opportunities
SET eligibility =
    CASE
        WHEN eligibility IS NULL THEN '[]'::jsonb
        ELSE jsonb_build_array(eligibility)
    END
WHERE eligibility IS NULL
   OR jsonb_typeof(eligibility) <> 'array';


UPDATE public.opportunities
SET skills =
    CASE
        WHEN required_skills IS NULL THEN '[]'::jsonb
        ELSE to_jsonb(required_skills)
    END
WHERE skills IS NULL
   OR jsonb_typeof(skills) <> 'array';


UPDATE public.opportunities
SET requirements =
    CASE
        WHEN education_requirements IS NULL
            THEN '[]'::jsonb

        ELSE jsonb_build_array(
            education_requirements
        )
    END
WHERE requirements IS NULL
   OR jsonb_typeof(requirements) <> 'array';


UPDATE public.opportunities
SET tags = '[]'::jsonb
WHERE tags IS NULL;


UPDATE public.opportunities
SET benefits = '[]'::jsonb
WHERE benefits IS NULL;


UPDATE public.opportunities
SET metadata = '{}'::jsonb
WHERE metadata IS NULL;


