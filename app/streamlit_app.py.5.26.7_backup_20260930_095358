def safe_list(value):
    """Return a list for dashboard rendering."""
    return value if isinstance(value, list) else []


def item_value(item, key, default=""):
    """Safely read a dictionary field."""
    if isinstance(item, dict):
        return item.get(key, default)
    return default


def render_recommendation_list(items):
    """Render recommendation cards."""
    items = safe_list(items)

    if not items:
        st.caption("No recommendations available.")
        return

    for index, item in enumerate(items, start=1):

        title = item_value(item, "title", f"Recommendation {index}")
        description = item_value(item, "description")
        action = item_value(item, "action")
        evidence = item_value(item, "evidence")
        priority = item_value(item, "priority")

        with st.container(border=True):

            st.markdown(f"**{title}**")

            if priority:
                st.caption(f"Priority: {priority}")

            if description:
                st.write(description)

            if action:
                st.markdown(f"**Action:** {action}")

            if evidence:
                st.caption(f"Evidence: {evidence}")


def render_analysis_items(items, empty_message):
    """Render grounded analysis items."""
    items = safe_list(items)

    if not items:
        st.caption(empty_message)
        return

    for item in items:

        title = item_value(item, "title", "Observation")
        description = item_value(item, "description")
        evidence = item_value(item, "evidence")

        with st.container(border=True):

            st.markdown(f"**{title}**")

            if description:
                st.write(description)

            if evidence:
                st.caption(f"Evidence: {evidence}")


def render_skill_assessment(items):
    """Render skill assessments."""
    items = safe_list(items)

    if not items:
