def _unique_preserve_order(items):
    """Remove duplicate strings while preserving order."""
    result = []
    seen = set()

    for item in items or []:
        value = str(item).strip()
        if not value:
            continue

        key = value.casefold()

        if key in seen:
            continue

        seen.add(key)
        result.append(value)

    return result


def _recommendation_text(item):
    """Safely convert recommendation entries to readable text."""
    if isinstance(item, str):
        return item.strip()

    if isinstance(item, dict):
        preferred_keys = [
            "recommendation",
            "suggestion",
            "improvement",
            "description",
            "action",
            "title",
            "text",
        ]

        for key in preferred_keys:
            value = item.get(key)

            if value not in (None, ""):
                return str(value).strip()

        return str(item)

    return str(item).strip()


def _extract_profile_data(profile_id):
    """Load the student's current profile from Supabase."""
    if not profile_id:
        return None

    response = (
        supabase
        .table("profiles")
        .select("*")
        .eq("id", str(profile_id))
        .limit(1)
        .execute()
    )

    if not response.data:
        return None

    return response.data[0]


def _build_approved_extraction(extraction, approved_profile):
    """
    Build ProfessionalCV-compatible source data.

    Approved profile values are deliberately merged only after explicit
    user approval. The original AI extraction is never overwritten.
    """
    if not isinstance(extraction, dict):
        extraction = {}

    merged = dict(extraction)

    contact = dict(
        extraction.get("contact")
        or extraction.get("personal_information")
        or extraction.get("personal_info")
        or {}
    )

    # Approved profile fields become authoritative only for the generated
    # Professional CV. Original extraction remains untouched in DB.
    if approved_profile:
        for field in [
            "full_name",
            "email",
            "phone",
            "location",
        ]:
            value = approved_profile.get(field)

            if value not in (None, ""):
                contact[field] = value

        if approved_profile.get("career_summary"):
            merged["professional_summary"] = approved_profile["career_summary"]

        if approved_profile.get("certifications"):
            merged["certifications"] = approved_profile["certifications"]

        if approved_profile.get("achievements"):
            merged["achievements"] = approved_profile["achievements"]

    merged["contact"] = contact

    return merged


def _build_professional_cv_from_approved_data(
    extraction,
    approved_profile,
):
    """Generate a ProfessionalCV only after the user approval step."""
    approved_source = _build_approved_extraction(
        extraction=extraction,
        approved_profile=approved_profile,
    )

    # ProfessionalCVService expects an improved_cv-like dictionary.
    improved_cv = {
        "professional_summary": (
            approved_source.get("professional_summary")
            or approved_source.get("career_summary")
            or ""
        ),
        "experience": approved_source.get("experience") or [],
        "skills": approved_source.get("skills") or [],
        "education": approved_source.get("education") or [],
        "certifications": approved_source.get("certifications") or [],
        "projects": approved_source.get("projects") or [],
        "achievements": approved_source.get("achievements") or [],
        "languages": approved_source.get("languages") or [],
        "warnings": approved_source.get("warnings") or [],
    }

    return professional_cv_service.build(
        improved_cv=improved_cv,
        extraction=approved_source,
    )



def _dedupe_workflow_warnings(value):
    if not isinstance(value, list):
        return value

    return _unique_preserve_order(value)


def render_final_cv_approval_flow(
    cv_id,
    extraction_data,
    analysis_data=None,
    recommendations_data=None,
):
    """
    Final human-in-the-loop CV approval workflow.

    Flow:
        AI recommendations
              ↓
        recommendation approval
              ↓
        CV ↔ profile comparison
              ↓
        profile-change approval
              ↓
        Professional CV generation
              ↓
        DOCX / PDF
              ↓
        persistent version
    """

    st.markdown("---")
    st.header("✅ Final CV Approval & Professional CV")

    if not cv_id:
        st.info("CV ID required for approval workflow.")
        return

    if not isinstance(extraction_data, dict):
        st.warning("CV extraction data is not available.")
        return

    profile_id = st.session_state.get("profile_id")

    if not profile_id:
        st.warning(
            "No profile is selected. Select a student profile before approving CV changes."
        )
        return

    # --------------------------------------------------------------------------------------
    # A. LOAD PROFILE
    # --------------------------------------------------------------------------------------

    try:
        profile = _extract_profile_data(profile_id)
    except Exception as exc:
        st.error(f"Profile could not be loaded: {type(exc).__name__}: {exc}")
        return

    if not profile:
        st.warning("Selected profile was not found.")
        return

    # --------------------------------------------------------------------------------------
    # B. AI RECOMMENDATIONS — EXPLICIT USER APPROVAL
    # --------------------------------------------------------------------------------------

    st.subheader("1️⃣ AI Recommendations")

    recommendation_items = []

    if isinstance(recommendations_data, dict):
        recommendation_groups = [
            ("CV Improvements", "cv_improvements"),
            ("Skill Recommendations", "skill_recommendations"),
            ("Experience Recommendations", "experience_recommendations"),
            ("Job Match Recommendations", "job_match_recommendations"),
            ("Profile Recommendations", "profile_recommendations"),
        ]

        for title, key in recommendation_groups:
            values = recommendations_data.get(key) or []

            if not isinstance(values, list):
                values = [values]

            for index, item in enumerate(values):
                text_value = _recommendation_text(item)

                if text_value:
                    recommendation_items.append(
                        {
                            "group": title,
                            "key": key,
                            "index": index,
                            "text": text_value,
                        }
                    )

    if recommendation_items:
        st.caption(
            "AI recommendations sirf suggestions hain. "
            "Koi change automatic apply nahi hoga."
        )

        approved_recommendations = st.session_state.setdefault(
            "approved_recommendations",
            {},
        )

        for item in recommendation_items:
            rec_key = (
                f"{item['key']}__{item['index']}"
            )

            checked = st.checkbox(
                f"{item['group']}: {item['text']}",
                value=bool(approved_recommendations.get(rec_key, False)),
                key=f"approve_rec_{rec_key}",
            )

            approved_recommendations[rec_key] = checked

        selected_recommendations = [
            item
            for item in recommendation_items
            if approved_recommendations.get(
                f"{item['key']}__{item['index']}",
                False,
            )
        ]

        st.info(
            f"{len(selected_recommendations)} recommendation(s) approved "
            f"for the professional CV workflow."
        )

    else:
        st.info("No AI recommendations are available for approval.")

    # --------------------------------------------------------------------------------------
    # C. CV ↔ PROFILE COMPARISON
    # --------------------------------------------------------------------------------------

    st.subheader("2️⃣ CV vs Existing Profile")

    try:
        comparison = cv_profile_comparison_service.compare(
            profile=profile,
            extraction=extraction_data,
        )
    except Exception as exc:
        st.error(
            f"CV/profile comparison failed: "
            f"{type(exc).__name__}: {exc}"
        )
        return

    if comparison.warnings:
        for warning in _unique_preserve_order(comparison.warnings):
            st.warning(warning)

    approved_profile_fields = []

    if not comparison.has_differences:
        st.success(
            "CV aur existing profile mein koi conflicting profile field nahi mila."
        )
        st.session_state["cv_profile_comparison"] = comparison.model_dump(
            mode="json"
        )

    else:
        st.caption(
            "Neeche har difference ko individually approve/reject karein. "
            "Reject karne par existing profile unchanged rahegi."
        )

        approved_state = st.session_state.setdefault(
            "approved_profile_fields",
            {},
        )

        for difference in comparison.differences:
            field = difference.field

            st.markdown(f"**{field.replace('_', ' ').title()}**")

            col1, col2 = st.columns(2)

            with col1:
                st.caption("Existing Profile")
                st.code(
                    str(difference.profile_value)
                    if difference.profile_value not in (None, "")
                    else "(empty)"
                )

            with col2:
                st.caption("CV / AI Extraction")
                st.code(
                    str(difference.cv_value)
                    if difference.cv_value not in (None, "")
                    else "(empty)"
                )

            approved = st.checkbox(
                f"Approve CV value for `{field}`",
                value=bool(approved_state.get(field, False)),
                key=f"approve_profile_{field}",
            )

            approved_state[field] = approved

            if approved:
                approved_profile_fields.append(field)

            st.markdown("---")

        st.session_state["cv_profile_comparison"] = comparison.model_dump(
            mode="json"
        )

    # --------------------------------------------------------------------------------------
    # D. APPLY APPROVED PROFILE VALUES — USER APPROVAL REQUIRED
    # --------------------------------------------------------------------------------------

    approved_profile = dict(profile)

    if comparison.has_differences and approved_profile_fields:
        try:
            approved_profile_model = (
                cv_profile_comparison_service.apply_approved_changes(
                    profile=profile,
                    comparison=comparison,
                    approved_fields=approved_profile_fields,
                )
            )

            approved_profile = approved_profile_model.model_dump(
                mode="json"
            )

            st.success(
                f"{len(approved_profile_fields)} profile change(s) approved "
                f"for this CV generation."
            )

        except Exception as exc:
            st.error(
                f"Approved profile changes could not be prepared: "
                f"{type(exc).__name__}: {exc}"
            )
            return

    elif comparison.has_differences:
        st.info(
            "Abhi koi profile difference approved nahi hai. "
            "Existing profile values use hongi."
        )

    # --------------------------------------------------------------------------------------
    # E. PROFILE UPDATE IS ALSO EXPLICIT
    # --------------------------------------------------------------------------------------

    if comparison.has_differences and approved_profile_fields:
        st.markdown("### Optional: Update Existing Profile")

        update_profile = st.checkbox(
            "Approved values ko existing Supabase profile mein bhi save karein.",
            value=False,
            key="confirm_profile_database_update",
        )

        if update_profile:
            st.warning(
                "Yeh action existing profile data update karega. "
                "Sirf explicitly approved fields update honge."
            )

            if st.button(
                "💾 Save Approved Profile Changes",
                key="save_approved_profile_changes",
                type="secondary",
            ):
                try:
                    allowed_fields = set(
                        cv_profile_comparison_service.PROFILE_FIELDS
                    )

                    update_payload = {
                        field: approved_profile[field]
                        for field in approved_profile_fields
                        if field in allowed_fields
                    }

                    if update_payload:
                        response = (
                            supabase
                            .table("profiles")
                            .update(update_payload)
                            .eq("id", str(profile_id))
                            .execute()
                        )

                        if response.data:
                            st.session_state["profile_record"] = (
                                response.data[0]
                            )

                        st.success(
                            "Approved profile changes Supabase mein save ho gayi hain."
                        )
                        st.rerun()

                except Exception as exc:
                    st.error(
                        f"Profile update failed: "
                        f"{type(exc).__name__}: {exc}"
                    )

    # --------------------------------------------------------------------------------------
    # F. GENERATE PROFESSIONAL CV
    # --------------------------------------------------------------------------------------

    st.subheader("3️⃣ Generate Professional CV")

    st.caption(
        "Professional CV tab generate hoga jab aap explicitly approve karenge."
    )

    generate_key = f"generate_professional_cv_{cv_id}"

    if st.button(
        "✨ Generate Professional CV",
        key=generate_key,
        type="primary",
    ):
        try:
            professional_cv = _build_professional_cv_from_approved_data(
                extraction=extraction_data,
                approved_profile=approved_profile,
            )

            st.session_state["professional_cv"] = (
                professional_cv.model_dump(mode="json")
            )

            st.session_state["professional_cv_cv_id"] = str(cv_id)

            st.success(
                "Professional CV successfully generated."
            )

        except Exception as exc:
            st.error(
                f"Professional CV generation failed: "
                f"{type(exc).__name__}: {exc}"
            )
            return

    # --------------------------------------------------------------------------------------
    # G. PREVIEW + EXPORT
    # --------------------------------------------------------------------------------------

    professional_cv_data = st.session_state.get("professional_cv")

    if not professional_cv_data:
        st.info(
            "Generate Professional CV button press karne ke baad "
            "preview aur export options yahan appear honge."
        )
        return

    if (
        st.session_state.get("professional_cv_cv_id")
        and str(st.session_state["professional_cv_cv_id"]) != str(cv_id)
    ):
        st.info(
            "Current Professional CV kisi aur CV ka hai. "
            "Is CV ke liye dobara generate karein."
        )
        return

    try:
        professional_cv = ProfessionalCV.model_validate(
            professional_cv_data
        )
    except Exception as exc:
        st.error(
            f"Professional CV validation failed: "
            f"{type(exc).__name__}: {exc}"
        )
        return

    st.subheader("4️⃣ Professional CV Preview")

    try:
        render_professional_cv_preview(professional_cv)
    except Exception as exc:
        st.error(
            f"Professional CV preview failed: "
