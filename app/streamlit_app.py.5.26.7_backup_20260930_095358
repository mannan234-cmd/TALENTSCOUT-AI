def render_extraction(extraction):
    """Render structured CV extraction."""
    if not isinstance(extraction, dict):
        st.info("Structured extraction is not available in the API response.")
        return

    profile_col1, profile_col2 = st.columns(2)

    with profile_col1:

        full_name = extraction.get("full_name")
        professional_title = extraction.get("professional_title")

        st.markdown("### 👤 Profile")

        if full_name:
            st.write(f"**Name:** {full_name}")
        else:
            st.write("**Name:** Not available")

        if professional_title:
            st.write(f"**Title:** {professional_title}")
        else:
            st.write("**Title:** Not available")

    with profile_col2:

        summary = extraction.get("professional_summary")

        st.markdown("### 📝 Summary")

        if summary:
            st.write(summary)
        else:
            st.caption("No professional summary extracted.")

    st.markdown("### 🛠️ Skills")

    skills = safe_list(extraction.get("skills"))

    if skills:

        skill_names = []

        for skill in skills:
            if isinstance(skill, dict):
                name = skill.get("name")
                if name:
                    skill_names.append(name)

        if skill_names:
            st.write(" • ".join(skill_names))
        else:
            st.caption("No named skills available.")

    else:
        st.caption("No skills extracted.")

    st.markdown("### 💼 Experience")

    experiences = safe_list(extraction.get("experience"))

    if experiences:

        for experience in experiences:

            employer = item_value(
                experience,
                "employer",
                "Employer not specified",
            )

            job_title = item_value(
                experience,
                "job_title",
                "Role not specified",
            )

            description = item_value(
                experience,
                "description",
            )

            st.markdown(
                f"**{job_title} — {employer}**"
            )

            if description:
                st.write(description)

    else:
        st.caption("No experience entries extracted.")

    st.markdown("### 🎓 Education")

    education = safe_list(extraction.get("education"))

    if education:

        for entry in education:

            degree = item_value(entry, "degree")
            field = item_value(entry, "field_of_study")
            institution = item_value(entry, "institution")

            title_parts = [
                value
                for value in [degree, field]
                if value
            ]

            title = " — ".join(title_parts)

            if not title:
                title = "Education"

            if institution:
                title = f"{title} — {institution}"

            st.markdown(f"**{title}**")

    else:
        st.caption("No education entries extracted.")

    st.markdown("### 🏆 Certifications")

    certifications = safe_list(
        extraction.get("certifications")
    )

    if certifications:

        for certification in certifications:

            name = item_value(
                certification,
                "name",
                "Certification",
            )

            organization = item_value(
                certification,
                "issuing_organization",
            )

            if organization:
                st.write(f"**{name}** — {organization}")
            else:
                st.write(f"**{name}**")

    else:
        st.caption("No certifications extracted.")

    st.markdown("### 🚀 Projects")

    projects = safe_list(extraction.get("projects"))

    if projects:

        for project in projects:

            name = item_value(
                project,
                "name",
                "Project",
            )

            description = item_value(
                project,
                "description",
            )

            technologies = item_value(
                project,
                "technologies",
                [],
            )

            st.markdown(f"**{name}**")

            if description:
                st.write(description)

            if technologies:
                st.caption(
                    "Technologies: "
                    + ", ".join(technologies)
                )

    else:
        st.caption("No projects extracted.")


def render_matching(matching):
    """Render job matching results."""
    if not isinstance(matching, dict):
        st.info("Job matching was not requested or is not available.")
        return

    summary = matching.get("overall_summary")

    if summary:
        st.markdown("### 🎯 Match Summary")
        st.info(summary)

    st.markdown("### 🛠️ Skills Match")

    skill_matches = safe_list(
        matching.get("skills_match")
    )

    if skill_matches:

        for item in skill_matches:

            skill = item_value(item, "skill", "Skill")
            status = item_value(item, "match_status", "Unknown")
            explanation = item_value(item, "explanation")
            cv_evidence = item_value(item, "cv_evidence")
            job_evidence = item_value(item, "job_evidence")

            with st.container(border=True):

                st.markdown(f"**{skill}**")
                st.write(f"Match status: **{status}**")

                if explanation:
                    st.write(explanation)

                if cv_evidence:
                    st.caption(f"CV evidence: {cv_evidence}")

                if job_evidence:
                    st.caption(f"Job evidence: {job_evidence}")

    else:
        st.caption("No skill matching results available.")

    st.markdown("### 💼 Experience Match")

    experience_matches = safe_list(
        matching.get("experience_match")
    )

    if experience_matches:

        for item in experience_matches:

            requirement = item_value(
                item,
                "requirement",
                "Requirement",
            )

            status = item_value(
                item,
                "match_status",
                "Unknown",
            )

            explanation = item_value(
                item,
                "explanation",
            )

            with st.container(border=True):

                st.markdown(f"**{requirement}**")
                st.write(f"Match status: **{status}**")

                if explanation:
                    st.write(explanation)

    else:
        st.caption("No experience matching results available.")

    st.markdown("### 🎓 Education Match")

    education_matches = safe_list(
        matching.get("education_match")
    )

    if education_matches:

        for item in education_matches:

            requirement = item_value(
                item,
                "requirement",
                "Requirement",
            )

            status = item_value(
                item,
                "match_status",
                "Unknown",
            )

            explanation = item_value(
                item,
                "explanation",
            )

            with st.container(border=True):

                st.markdown(f"**{requirement}**")
                st.write(f"Match status: **{status}**")

                if explanation:
                    st.write(explanation)

    else:
        st.caption("No education matching results available.")

    st.markdown("### ⚠️ Gaps")

    gaps = safe_list(matching.get("gaps"))

    if gaps:

        for gap in gaps:

            title = item_value(
                gap,
                "title",
                "Gap",
            )

            description = item_value(
                gap,
                "description",
            )

            with st.container(border=True):

                st.markdown(f"**{title}**")

                if description:
                    st.write(description)

    else:
        st.success("No documented job-match gaps were returned.")


