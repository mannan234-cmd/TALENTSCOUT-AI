    use_container_width=True,
):

    st.switch_page("pages/profile.py")


st.info(
    "TalentScout AI is currently under development. "
    "More career intelligence modules will be added step-by-step."
)


def render_professional_cv_preview(professional_cv):
    if not professional_cv:
        st.info("Professional CV preview is not available yet.")
        return

    data = (
        professional_cv.model_dump(mode="json")
        if hasattr(professional_cv, "model_dump")
        else professional_cv
    )

    st.markdown("## Professional CV Preview")

    name = data.get("full_name") or "Candidate"
    contact = data.get("contact_line") or ""

    st.markdown(f"# {name}")

    if contact:
        st.caption(contact)

    if data.get("professional_summary"):
        st.markdown("### Professional Summary")
        st.write(data["professional_summary"])

    experience = data.get("experience") or []
    if experience:
        st.markdown("### Experience")
        for item in experience:
            heading = " — ".join(
                x for x in [
                    item.get("title", ""),
                    item.get("company", "")
                ] if x
            )

            if item.get("dates"):
                heading = f"{heading} ({item['dates']})"

            if heading:
                st.markdown(f"**{heading}**")

            if item.get("description"):
                st.write(item["description"])

    skills = data.get("skills") or []
    if skills:
        st.markdown("### Skills")
        st.write(" • ".join(str(x) for x in skills))

    education = data.get("education") or []
    if education:
        st.markdown("### Education")
        for item in education:
            line = " — ".join(
                x for x in [
                    item.get("degree", ""),
                    item.get("institution", "")
                ] if x
            )

            if item.get("dates"):
                line = f"{line} ({item['dates']})"

            if line:
                st.markdown(f"**{line}**")

    certifications = data.get("certifications") or []
    if certifications:
        st.markdown("### Certifications")
        for item in certifications:
            st.markdown(f"- {item}")

    projects = data.get("projects") or []
    if projects:
        st.markdown("### Projects")
        for item in projects:
            if item.get("name"):
                st.markdown(f"**{item['name']}**")
            if item.get("description"):
                st.write(item["description"])

    achievements = data.get("achievements") or []
    if achievements:
        st.markdown("### Achievements")
        for item in achievements:
            st.markdown(f"- {item}")

    languages = data.get("languages") or []
    if languages:
        st.markdown("### Languages")
        st.write(" • ".join(str(x) for x in languages))



def render_cv_version_history(cv_id, current_professional_cv=None):
    """Render persistent CV version history with preview/export/restore."""

    st.markdown("---")
    st.subheader("CV Version History")

    if not cv_id:
        st.info("CV ID required for version history.")
        return

    try:
        versions = cv_version_persistence_service.list_versions(cv_id)
    except Exception as exc:
        st.error(f"Unable to load CV versions: {exc}")
        return

    if not versions:
        st.info(
            "No saved CV versions yet. "
            "Save a Professional CV snapshot to create Version 1."
        )

        if current_professional_cv is not None:
            if st.button(
                "Save Current CV as Version 1",
                key="save_first_cv_version",
            ):
                try:
                    saved = cv_version_persistence_service.create_version(
                        cv_id=cv_id,
                        professional_cv=current_professional_cv,
                        label="Initial Professional CV",
                    )

                    st.session_state["professional_cv"] = (
                        current_professional_cv
                    )

                    st.success(
                        f"Version {saved['version_number']} saved successfully."
                    )
                    st.rerun()

                except Exception as exc:
                    st.error(f"Unable to save version: {exc}")

        return

    # -----------------------------------------------------
    # Version selector
    # -----------------------------------------------------

    version_options = {
        f"Version {item['version_number']} — "
        f"{item.get('label') or 'Untitled'} — "
        f"{str(item.get('created_at', ''))[:19]}": item
        for item in versions
    }

    selected_label = st.selectbox(
        "Select version",
        list(version_options.keys()),
        key="selected_cv_version",
    )

    selected = version_options[selected_label]
    selected_cv_data = selected.get("professional_cv") or {}

    st.markdown(
        f"### Version {selected['version_number']}"
    )

    if selected.get("label"):
        st.caption(f"Label: {selected['label']}")

    if selected.get("created_at"):
        st.caption(f"Created: {selected['created_at']}")

    # -----------------------------------------------------
    # Preview
    # -----------------------------------------------------

    st.markdown("#### Previous Version Preview")

    try:
        previous_cv = ProfessionalCV.model_validate(selected_cv_data)

        if previous_cv.full_name:
            st.markdown(f"## {previous_cv.full_name}")

        if previous_cv.contact_line:
            st.caption(previous_cv.contact_line)

        if previous_cv.professional_summary:
            st.markdown("**Professional Summary**")
            st.write(previous_cv.professional_summary)

        if previous_cv.skills:
            st.markdown("**Skills**")
            st.write(", ".join(previous_cv.skills))

        if previous_cv.experience:
            st.markdown("**Experience**")
            for item in previous_cv.experience:
                if isinstance(item, dict):
                    title = (
                        item.get("title")
                        or item.get("role")
                        or item.get("position")
                        or "Experience"
                    )
                    company = item.get("company") or item.get("organization") or ""

                    st.markdown(
                        f"**{title}**"
                        + (f" — {company}" if company else "")
                    )

                    description = (
                        item.get("description")
                        or item.get("summary")
                        or item.get("responsibilities")
                    )

                    if description:
                        if isinstance(description, list):
                            for bullet in description:
                                st.write(f"- {bullet}")
                        else:
                            st.write(description)

        if previous_cv.education:
            st.markdown("**Education**")
            for item in previous_cv.education:
                if isinstance(item, dict):
                    degree = item.get("degree") or item.get("qualification") or ""
                    institution = (
                        item.get("institution")
                        or item.get("university")
                        or item.get("school")
                        or ""
                    )

                    line = " — ".join(
                        value for value in [degree, institution]
                        if value
                    )

                    if line:
                        st.write(line)

        if previous_cv.certifications:
            st.markdown("**Certifications**")
            for item in previous_cv.certifications:
                st.write(f"- {item}")

        if previous_cv.projects:
            st.markdown("**Projects**")
            for item in previous_cv.projects:
                if isinstance(item, dict):
                    name = item.get("name") or item.get("title") or "Project"
                    st.markdown(f"**{name}**")

                    description = (
                        item.get("description")
                        or item.get("summary")
                    )

                    if description:
                        st.write(description)

        if previous_cv.achievements:
            st.markdown("**Achievements**")
            for item in previous_cv.achievements:
                st.write(f"- {item}")

        if previous_cv.languages:
            st.markdown("**Languages**")
            st.write(", ".join(previous_cv.languages))

    except Exception as exc:
        st.warning(
            f"Structured preview unavailable: {exc}"
        )

        st.json(selected_cv_data)

    # -----------------------------------------------------
    # Export
    # -----------------------------------------------------

    st.markdown("#### Export Previous Version")

    col1, col2 = st.columns(2)

    try:
        exporter = CVExportService()

        with col1:
            docx_bytes = exporter.generate_docx(previous_cv)

            st.download_button(
                "Download DOCX",
                data=docx_bytes,
                file_name=(
                    f"cv_version_{selected['version_number']}.docx"
                ),
                mime=(
                    "application/vnd.openxmlformats-officedocument."
                    "wordprocessingml.document"
                ),
                key=f"download_docx_{selected['version_number']}",
            )

        with col2:
            pdf_bytes = exporter.generate_pdf(previous_cv)

            st.download_button(
                "Download PDF",
                data=pdf_bytes,
                file_name=(
                    f"cv_version_{selected['version_number']}.pdf"
                ),
                mime="application/pdf",
                key=f"download_pdf_{selected['version_number']}",
            )

    except Exception as exc:
        st.error(f"Export failed: {exc}")

    # -----------------------------------------------------
    # Restore
    # -----------------------------------------------------

    st.markdown("#### Restore Previous Version")

    st.warning(
        "Restore historical snapshot ko current working CV banayega. "
        "Historical version delete ya overwrite nahi hogi."
    )

    if st.button(
        f"Restore Version {selected['version_number']}",
        key=f"restore_version_{selected['version_number']}",
    ):
        try:
            restored = cv_version_persistence_service.restore_version(
                cv_id=cv_id,
                version_number=int(selected["version_number"]),
            )

            if not restored:
                st.error("Selected version could not be restored.")
                return

            restored_cv = ProfessionalCV.model_validate(
                restored["professional_cv"]
            )

            st.session_state["professional_cv"] = restored_cv
            st.session_state["restored_cv_version"] = int(
                restored["version_number"]
            )

            st.success(
                f"Version {restored['version_number']} restored "
                "as the current working CV."
            )

            st.rerun()

        except Exception as exc:
            st.error(f"Restore failed: {exc}")


    # 4.31 — Persistent CV Version History
    render_cv_version_history(
        cv_id=cv_id,
        current_professional_cv=st.session_state.get("professional_cv"),
    )
