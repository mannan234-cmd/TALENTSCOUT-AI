from __future__ import annotations

from datetime import datetime
from enum import Enum
from typing import Any, Dict, List, Optional

from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator


class MatchCategory(str, Enum):
    """Human-readable deterministic match classification."""

    EXCELLENT = "excellent"
    STRONG = "strong"
    MODERATE = "moderate"
    WEAK = "weak"
    INELIGIBLE = "ineligible"




class MatchComponent(str, Enum):
    """Canonical deterministic opportunity-matching components."""

    SKILLS = "skills"
    EDUCATION = "education"
    EXPERIENCE = "experience"
    PROJECTS = "projects"
    CAREER_GOALS = "career_goals"
    INTERESTS = "interests"
    LOCATION = "location"
    WORK_MODE = "work_mode"
class EligibilityStatus(str, Enum):
    """Canonical deterministic eligibility state."""
    ELIGIBLE = "eligible"
    INELIGIBLE = "ineligible"


class MatchResult(BaseModel):
    """
    Canonical domain result produced by the Opportunity Matching engine.

    This model intentionally separates:
    - eligibility
    - deterministic score
    - classification
    - component scores
    - evidence
    - explanation
    - skill gaps

    Later matching phases extend the data feeding this contract rather
    than creating competing result structures.
    """

    model_config = ConfigDict(extra="forbid")

    profile_id: str = Field(
        min_length=1,
        description="Student/profile identifier.",
    )

    opportunity_id: str = Field(
        min_length=1,
        description="Opportunity identifier.",
    )

    eligible: bool = Field(
        description="Whether the student passes hard eligibility gates.",
    )

    score: float = Field(
        ge=0.0,
        le=100.0,
        description="Deterministic overall match score.",
    )

    category: MatchCategory = Field(
        description="Human-readable match category.",
    )

    component_scores: Dict[str, float] = Field(
        default_factory=dict,
        description="Named matching component scores.",
    )

    evidence: Dict[str, List[str]] = Field(
        default_factory=dict,
        description="Evidence supporting matching decisions.",
    )

    explanations: List[str] = Field(
        default_factory=list,
        description="Human-readable reasons for the result.",
    )

    skill_gaps: List[str] = Field(
        default_factory=list,
        description="Skills relevant to the opportunity that the student lacks.",
    )

    calculated_at: datetime = Field(
        default_factory=datetime.utcnow,
        description="UTC timestamp when the match was calculated.",
    )

    metadata: Dict[str, Any] = Field(
        default_factory=dict,
        description="Extensible non-authoritative metadata.",
    )

    eligibility_reasons: List[str] = Field(default_factory=list)

    @field_validator("eligibility_reasons")
    @classmethod
    def _normalize_eligibility_reasons(
        cls,
        reasons: List[str],
    ) -> List[str]:
        """Normalize eligibility reasons for stable downstream evidence."""
        normalized = []
        seen = set()

        for reason in reasons:
            clean = str(reason).strip()

            if not clean:
                continue

            key = clean.casefold()

            if key not in seen:
                seen.add(key)
                normalized.append(clean)

        return normalized

    @field_validator("component_scores")
    @classmethod

    @model_validator(mode="after")
    def _validate_eligibility_consistency(self) -> "MatchResult":
        """Keep eligibility state and category semantically consistent."""
        if (
            self.eligible
            and self.category == MatchCategory.INELIGIBLE
        ):
            raise ValueError(
                "Eligible match cannot have INELIGIBLE category."
            )

        if (
            not self.eligible
            and self.category != MatchCategory.INELIGIBLE
        ):
            raise ValueError(
                "Ineligible match must have INELIGIBLE category."
            )

        return self

    def _validate_component_scores(
        cls,
        component_scores: Dict[str, float],
    ) -> Dict[str, float]:
        normalized: Dict[str, float] = {}

        for key, value in component_scores.items():
            clean_key = str(key).strip()

            if not clean_key:
                raise ValueError(
                    "component_scores cannot contain empty keys."
                )

            numeric_value = float(value)

            if not 0.0 <= numeric_value <= 100.0:
                raise ValueError(
                    f"Component score for '{clean_key}' "
                    "must be between 0 and 100."
                )

            normalized[clean_key] = numeric_value

        return normalized


    @staticmethod
    def _normalize_text_list(
        values: List[str],
    ) -> List[str]:
        normalized: List[str] = []
        seen = set()

        for value in values:
            clean_value = str(value).strip()

            if not clean_value:
                continue

            identity = clean_value.casefold()

            if identity in seen:
                continue

            seen.add(identity)
            normalized.append(clean_value)

        return normalized
    @classmethod
    def validate_component_name(
        cls,
        component: str,
    ) -> str:
        """Normalize and validate a matching component name."""
        clean_component = str(component).strip().casefold()

        valid_components = {
            item.value
            for item in MatchComponent
        }

        if clean_component not in valid_components:
            raise ValueError(
                f"Unknown match component: {component}"
            )

        return clean_component

    @classmethod
    def validate_component_breakdown(
        cls,
        component_scores: Dict[str, float],
    ) -> Dict[str, float]:
        """Validate a complete named component-score breakdown."""
        normalized: Dict[str, float] = {}

        for component, score in component_scores.items():
            clean_component = cls.validate_component_name(
                component
            )

            numeric_score = float(score)

            if not 0.0 <= numeric_score <= 100.0:
                raise ValueError(
                    f"Component score for '{clean_component}' "
                    "must be between 0 and 100."
                )

            normalized[clean_component] = numeric_score

        return normalized
    @classmethod
    def validate_component_scores(
        cls,
        component_scores: Dict[str, float],
    ) -> Dict[str, float]:
        """Public validation helper for matching services."""
        return cls._validate_component_scores(component_scores)

    @classmethod
    def normalize_text_list(
        cls,
        values: List[str],
    ) -> List[str]:
        """Public normalization helper for evidence/gap lists."""
        return cls._normalize_text_list(values)
