from fastapi import FastAPI, HTTPException

from app.models.cv_workflow_api import (
    CVWorkflowRequest,
    CVWorkflowResponse,
)
from app.services.cv_workflow_service import CVWorkflowService


app = FastAPI(
    title="TalentScout_AI API",
    version="1.0.0",
    description="API for the TalentScout_AI CV analysis workflow.",
)

workflow_service = CVWorkflowService()


@app.get("/health")
def health() -> dict:
    return {
        "status": "ok",
        "service": "TalentScout_AI",
    }


@app.post(
    "/cv/workflow",
    response_model=CVWorkflowResponse,
)
def run_cv_workflow(
    request: CVWorkflowRequest,
) -> CVWorkflowResponse:
    try:
        result = workflow_service.run(
            cv_id=request.cv_id,
            source_text=request.source_text,
            job_description=request.job_description,
        )

        return CVWorkflowResponse.from_workflow_result(result)

    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc),
        ) from exc

    except RuntimeError as exc:
        raise HTTPException(
            status_code=500,
            detail=str(exc),
        ) from exc

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail="CV workflow execution failed.",
        ) from exc
