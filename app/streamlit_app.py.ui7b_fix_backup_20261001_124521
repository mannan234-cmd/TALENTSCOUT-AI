    extraction_data,
    analysis_data=None,
    recommendations_data=None,
):
    """
    Final human-in-the-loop CV approval workflow.

    Flow:
        AI recommendations
              ↓
        recommendation approval
              ↓
        CV ↔ profile comparison
              ↓
        profile-change approval
              ↓
        Professional CV generation
              ↓
        DOCX / PDF
              ↓
        persistent version
    """

    st.markdown("---")
    st.header("✅ Final CV Approval & Professional CV")

    if not cv_id:
        st.info("CV ID required for approval workflow.")
        return

    if not isinstance(extraction_data, dict):
        st.warning("CV extraction data is not available.")
        return

    profile_id = st.session_state.get("profile_id")

    if not profile_id:
        st.warning(
            "No profile is selected. Select a student profile before approving CV changes."
        )
        return

    # --------------------------------------------------------------------------------------
    # A. LOAD PROFILE
    # --------------------------------------------------------------------------------------

    try:
        profile = _extract_profile_data(profile_id)
    except Exception as exc:
        st.error(f"Profile could not be loaded: {type(exc).__name__}: {exc}")
        return

    if not profile:
        st.warning("Selected profile was not found.")
        return

    # --------------------------------------------------------------------------------------
    # B. AI RECOMMENDATIONS — EXPLICIT USER APPROVAL
    # --------------------------------------------------------------------------------------

    st.subheader("1️⃣ AI Recommendations")

    recommendation_items = []

    if isinstance(recommendations_data, dict):
        recommendation_groups = [
            ("CV Improvements", "cv_improvements"),
            ("Skill Recommendations", "skill_recommendations"),
            ("Experience Recommendations", "experience_recommendations"),
            ("Job Match Recommendations", "job_match_recommendations"),
            ("Profile Recommendations", "profile_recommendations"),
        ]

        for title, key in recommendation_groups:
            values = recommendations_data.get(key) or []

            if not isinstance(values, list):
                values = [values]

            for index, item in enumerate(values):
                text_value = _recommendation_text(item)

                if text_value:
                    recommendation_items.append(
                        {
                            "group": title,
                            "key": key,
                            "index": index,
                            "text": text_value,
                        }
                    )

    if recommendation_items:
        st.caption(
            "AI recommendations sirf suggestions hain. "
            "Koi change automatic apply nahi hoga."
        )

        approved_recommendations = st.session_state.setdefault(
            "approved_recommendations",
            {},
        )

        for item in recommendation_items:
            rec_key = (
                f"{item['key']}__{item['index']}"
            )

            checked = st.checkbox(
                f"{item['group']}: {item['text']}",
                value=bool(approved_recommendations.get(rec_key, False)),
                key=f"approve_rec_{rec_key}",
            )

            approved_recommendations[rec_key] = checked

        selected_recommendations = [
            item
            for item in recommendation_items
            if approved_recommendations.get(
                f"{item['key']}__{item['index']}",
                False,
            )
        ]

        st.info(
            f"{len(selected_recommendations)} recommendation(s) approved "
            f"for the professional CV workflow."
        )

    else:
        st.info("No AI recommendations are available for approval.")

    # --------------------------------------------------------------------------------------
    # C. CV ↔ PROFILE COMPARISON
    # --------------------------------------------------------------------------------------

    st.subheader("2️⃣ CV vs Existing Profile")

    try:
        comparison = cv_profile_comparison_service.compare(
            profile=profile,
            extraction=extraction_data,
        )
    except Exception as exc:
        st.error(
            f"CV/profile comparison failed: "
            f"{type(exc).__name__}: {exc}"
        )
        return

    if comparison.warnings:
        for warning in _unique_preserve_order(comparison.warnings):
            st.warning(warning)

    approved_profile_fields = []

    if not comparison.has_differences:
        st.success(
            "CV aur existing profile mein koi conflicting profile field nahi mila."
        )
        st.session_state["cv_profile_comparison"] = comparison.model_dump(
            mode="json"
        )

    else:
        st.caption(
            "Neeche har difference ko individually approve/reject karein. "
            "Reject karne par existing profile unchanged rahegi."
        )

        approved_state = st.session_state.setdefault(
            "approved_profile_fields",
            {},
        )

        for difference in comparison.differences:
            field = difference.field

            st.markdown(f"**{field.replace('_', ' ').title()}**")

            col1, col2 = st.columns(2)

            with col1:
                st.caption("Existing Profile")
                st.code(
                    str(difference.profile_value)
                    if difference.profile_value not in (None, "")
                    else "(empty)"
                )

            with col2:
                st.caption("CV / AI Extraction")
                st.code(
                    str(difference.cv_value)
                    if difference.cv_value not in (None, "")
                    else "(empty)"
                )

            approved = st.checkbox(
                f"Approve CV value for `{field}`",
                value=bool(approved_state.get(field, False)),
                key=f"approve_profile_{field}",
            )

            approved_state[field] = approved

            if approved:
                approved_profile_fields.append(field)

            st.markdown("---")

        st.session_state["cv_profile_comparison"] = comparison.model_dump(
            mode="json"
        )

    # --------------------------------------------------------------------------------------
    # D. APPLY APPROVED PROFILE VALUES — USER APPROVAL REQUIRED
    # --------------------------------------------------------------------------------------

    approved_profile = dict(profile)

    if comparison.has_differences and approved_profile_fields:
        try:
            approved_profile_model = (
                cv_profile_comparison_service.apply_approved_changes(
                    profile=profile,
                    comparison=comparison,
                    approved_fields=approved_profile_fields,
