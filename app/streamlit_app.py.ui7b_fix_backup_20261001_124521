def _initialize_auth_state():
    """Initialize authentication session state safely."""
    defaults = {
        "auth_mode": "login",
        "auth_user": None,
        "auth_authenticated": False,
        "auth_guest": False,
        "auth_error": None,
        "auth_message": None,
    }

    for key, value in defaults.items():
        if key not in st.session_state:
            st.session_state[key] = value


def _set_authenticated_user(user):
    """Store authenticated Supabase user in Streamlit session."""
    st.session_state["auth_user"] = user
    st.session_state["auth_authenticated"] = True
    st.session_state["auth_guest"] = False
    st.session_state["auth_error"] = None


def _activate_guest_mode():
    """Activate session-only guest mode."""
    st.session_state["auth_user"] = None
    st.session_state["auth_authenticated"] = False
    st.session_state["auth_guest"] = True
    st.session_state["auth_error"] = None
    st.session_state["auth_message"] = (
        "Guest Mode active. Public application areas are available."
    )


def _logout_user():
    """Sign out Supabase session and clear auth state."""
    try:
        AuthService.logout()
    except AuthServiceError:
        # Local session must still be cleared even if remote logout
        # reports an already-expired session.
        pass

    st.session_state["auth_user"] = None
    st.session_state["auth_authenticated"] = False
    st.session_state["auth_guest"] = False
    st.session_state["auth_error"] = None
    st.session_state["auth_message"] = "You have been logged out."



