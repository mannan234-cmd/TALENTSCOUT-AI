def is_authenticated_user() -> bool:
    """Return True only for an authenticated Supabase user."""
    return bool(
        st.session_state.get("auth_authenticated", False)
        and st.session_state.get("auth_user") is not None
    )


def is_guest_user() -> bool:
    """Return True only for explicit Guest Mode."""
    return bool(
        st.session_state.get("auth_guest", False)
        and not is_authenticated_user()
    )


def require_authenticated_user(
    feature_name: str = "this feature",
) -> bool:
    """
    Guard a protected feature.

    Returns:
        True  -> authenticated user may continue.
        False -> current user is guest / unauthenticated.
    """

    if is_authenticated_user():
        return True

    st.info(
        f"🔐 Please Login or Register to use {feature_name}."
    )

    if is_guest_user():
        st.caption(
            "You are currently using Guest Mode. "
            "Your personal data and account features require login."
        )

    return False


def render_authentication_ui():
    """Render the authentication entry / account controls."""
    _initialize_auth_state()
    authenticated = st.session_state.get('auth_authenticated', False)
    guest = st.session_state.get('auth_guest', False)
    if authenticated:
        user = st.session_state.get('auth_user')
        email = getattr(user, 'email', None) or 'Authenticated user'
        with st.sidebar:
            st.markdown('### 🔐 Account')
            st.success(f'Signed in as\n{email}')
            if st.button('🚪 Logout', key='auth_logout_button', use_container_width=True):
                _logout_user()
                st.rerun()
        return
    if guest:
        with st.sidebar:
            st.markdown('### 👤 Guest Mode')
            st.info('You are browsing as a guest.')
            if st.button('🔐 Login / Register', key='auth_guest_login_button', use_container_width=True):
                st.session_state['auth_guest'] = False
                st.session_state['auth_mode'] = 'login'
                st.session_state['auth_message'] = None
                st.rerun()
        return
    st.markdown('\n        <div style="text-align:center; padding:1.25rem 0 0.5rem 0;">\n            <div style="font-size:2.4rem; font-weight:700;">\n                Welcome to TalentScout AI\n            </div>\n            <div style="font-size:1.05rem; margin-top:0.4rem;">\n                Sign in to manage your career profile and opportunities.\n            </div>\n        </div>\n        ', unsafe_allow_html=True)
    auth_col, guest_col = st.columns([1.35, 0.85], gap='large')
    with auth_col:
        with st.container(border=True):
            st.markdown('### 🔐 Your Account')
            st.caption('Login to your account, or create one in a few simple steps.')
            mode = st.radio('Authentication', options=['Login', 'Register'], horizontal=True, key='auth_mode_selector', label_visibility='collapsed')
            email = st.text_input('Email', key='auth_email', placeholder='you@example.com')
            password = st.text_input('Password', type='password', key='auth_password', placeholder='Enter your password')
            if mode == 'Login':
                submit = st.button('🔐 Login', key='auth_login_button', type='primary', use_container_width=True)
                if submit:
                    try:
                        user = AuthService.login(email=email, password=password)
                        _set_authenticated_user(user)
                        st.session_state['auth_message'] = 'Login successful.'
                        st.rerun()
                    except AuthServiceError as exc:
                        st.session_state['auth_error'] = str(exc)
            else:
                confirm_password = st.text_input('Confirm Password', type='password', key='auth_confirm_password', placeholder='Re-enter your password')
                submit = st.button('📝 Register', key='auth_register_button', type='primary', use_container_width=True)
                if submit:
                    if password != confirm_password:
                        st.session_state['auth_error'] = 'Passwords do not match.'
                    else:
                        try:
                            user = AuthService.register(email=email, password=password)
                            _set_authenticated_user(user)
                            st.session_state['auth_message'] = 'Registration successful.'
                            st.rerun()
                        except AuthServiceError as exc:
                            st.session_state['auth_error'] = str(exc)
            auth_error = st.session_state.get('auth_error')
            if auth_error:
                st.error(auth_error)
            auth_message = st.session_state.get('auth_message')
            if auth_message:
                st.success(auth_message)
    with guest_col:
        with st.container(border=True):
            st.markdown('### 👤 Explore as Guest')
            st.caption('Browse opportunities and explore the interface without creating an account.')
            st.markdown('\n                **Available in Guest Mode**\n\n                • Browse opportunities\n                • Search and filter results\n                • View opportunity details\n\n                **Account required**\n\n                • Save opportunities\n                • Report opportunities\n                • Personal profile features\n                ')
            if st.button('👤 Continue as Guest', key='auth_guest_button', use_container_width=True):
                _activate_guest_mode()
                st.rerun()
    st.caption('You can switch between Login, Register, and Guest Mode at any time.')


