                "Job matching was skipped. Provide a job description "
                "to run job-specific matching."
            )

    # ----------------------------------------------------------
    # Recommendations
    # ----------------------------------------------------------

    with tabs[3]:

        recommendations = result.get(
            "recommendations"
        )

        if recommendations is None:
            recommendations = result.get(
                "ai_recommendations"
            )

        render_recommendations(recommendations)

    # ----------------------------------------------------------
    # Raw response
    # ----------------------------------------------------------

    with tabs[4]:

        st.json(result)


